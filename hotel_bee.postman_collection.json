{
  "info": {
    "_postman_id": "hotel-bee-api-collection",
    "name": "Hotel Bee API",
    "description": "Complete API collection for Hotel Bee backend. Set BASE_URL environment variable to http://localhost:5000/api/v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "BASE_URL", "value": "http://localhost:5000/api/v1", "type": "string" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{BASE_URL}}/health"
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@hotelbee.com\",\n  \"password\": \"HotelBee@123\"\n}"
            }
          }
        },
        {
          "name": "Get Current Admin",
          "request": { "method": "GET", "url": "{{BASE_URL}}/auth/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/auth/profile",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Admin Name\"\n}"
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "url": "{{BASE_URL}}/auth/change-password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"HotelBee@123\",\n  \"newPassword\": \"NewSecurePass@2024\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": { "method": "POST", "url": "{{BASE_URL}}/auth/logout" }
        }
      ]
    },
